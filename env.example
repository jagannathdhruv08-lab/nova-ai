# =====================================================================
# Nova AI — environment template
# COPY this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control.
# =====================================================================

# LLM provider (Groq, OpenAI-compatible)
GROQ_API_KEY=gsk_replace_me_with_a_real_groq_key

# BACKUP LLM provider - used automatically whenever Groq fails
# (rate limit / network / retired model), so Nova never stops replying.
OPENROUTER_API_KEY=sk-or-v1-replace_me_with_a_real_openrouter_key

# Optional: model for the OpenRouter backup. Default matches the Groq
# primary so answer quality stays consistent.
# OPENROUTER_MODEL=openai/gpt-oss-20b

# Gemini (used by Screen Watch / Camera / AI Image Detector).
# If absent, those features are disabled — the app still works.
GEMINI_API_KEY=AIza_replace_me_with_a_real_google_key

# Optional: which model the brain should call.
# Default: llama-3.1-8b-instant (fast, high daily limit).
NOVA_MODEL=llama-3.1-8b-instant

# Optional: cap on chat history entries before rotation (default 500).
NOVA_HISTORY_MAX=500

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
NOVA_LOG_LEVEL=INFO

# =====================================================================
# LOCAL LLM FALLBACK (Ollama) - last link in brain.py's failover chain.
# When Groq AND OpenRouter are unreachable, Nova can think locally.
# Install from ollama.com, pull a model, then enable here.
# =====================================================================
# OLLAMA_ENABLED=1
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# =====================================================================
# TELEGRAM BRIDGE (python telegram_bridge.py)
# Talk to Nova from your phone. Get a token from @BotFather.
# SECURITY: only these chat ids get replies; empty = nobody until you
# add your own (the bot prints your chat id on first contact).
# =====================================================================
# TELEGRAM_BOT_TOKEN=123456789:AA...your_botfather_token
# TELEGRAM_ALLOWED_CHAT_IDS=
